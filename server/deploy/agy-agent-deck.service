[Unit]
Description=AGY Remote Hub v2.0 Steam Deck Local Node Agent (Port 8769)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/agy_remote/server
Environment=PYTHONIOENCODING=utf-8
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/agy_remote/server/.venv/bin/python -u server.py agent --platform deck --config agent_config.json --host 127.0.0.1 --port 8769
Restart=always
RestartSec=3s

[Install]
WantedBy=default.target
